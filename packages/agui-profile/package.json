{
  "name": "@ayni.org/ayni-agui-profile",
  "version": "3.1.0",
  "description": "Ayni AG-UI Profile 3.1: the wire contract between an Ayni Agent and an Ayni UI (types, constants, JSON schemas, app links)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/2060-io/ayni-agent",
    "directory": "packages/agui-profile"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/2060-io/ayni-agent/tree/main/packages/agui-profile",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ayni",
    "ag-ui",
    "didcomm",
    "verifiable-trust"
  ]
}
