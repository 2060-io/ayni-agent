# ---- identity and corporation -----------------------------------------------------
# Corporation id on the registry (created with dev/vs-agent/bootstrap.sh).
VERANA_CORPORATION_ID=
# BIP-39 mnemonic of the agent's account (the vs_operator). Keep it out of git.
VERANA_ACCOUNT_MNEMONIC=

# ---- network (devnet until the testnet v4 upgrade) ----------------------------------
VERANA_CHAIN_ID=vna-devnet-1
VERANA_RPC_ENDPOINT_URL=https://rpc.devnet.verana.network
VERANA_INDEXER_BASE_URL=https://idx.devnet.verana.network
TRUSTED_ECS_ECOSYSTEM_DIDS=did:webvh:QmTjgAgrSEKmXDgyzQvzar92uwQvW8VSJV8ZS5SjzYqCxX:ecs-ecosystem.devnet.verana.network

# ---- the service -------------------------------------------------------------------
# Public origin (the ngrok tunnel). The DID is derived from it on first start: keep it stable.
PUBLIC_API_BASE_URL=https://example.ngrok-free.dev
AGENT_PUBLIC_DID_METHOD=webvh
AGENT_MODE=standalone

ECS_CLAIMS_SERVICE_NAME=Ayni Agent (dev)
ECS_CLAIMS_SERVICE_TYPE=AIAgent
ECS_CLAIMS_SERVICE_DESCRIPTION=Development instance of the Ayni Agent.
ECS_CLAIMS_SERVICE_MINIMUM_AGE_REQUIRED=0
ECS_CLAIMS_SERVICE_LOGO_URI=https://example.ngrok-free.dev/vt/default/logo.svg
ECS_CLAIMS_SERVICE_TERMS_AND_CONDITIONS_URI=https://example.ngrok-free.dev/vt/default/terms.html
ECS_CLAIMS_SERVICE_PRIVACY_POLICY_URI=https://example.ngrok-free.dev/vt/default/privacy.html

ECS_CLAIMS_ORG_NAME=2060 OÜ (dev)
ECS_CLAIMS_ORG_LOGO_URI=https://2060.io/images/logo-squared.svg
ECS_CLAIMS_ORG_REGISTRY_ID=16853041
ECS_CLAIMS_ORG_ADDRESS=Harju maakond, Tallinn, Kesklinna linnaosa, Ahtri tn 12, 15551
ECS_CLAIMS_ORG_COUNTRY_CODE=EE

# ---- controller (the ayni-agent process on this host) -----------------------------
# EVENTS_WEBHOOK_URL=http://host.docker.internal:3020/vs-agent/events
AGENT_LOG_LEVEL=info
ADMIN_API_LOG_LEVEL=info

# ---- database -----------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Image to run; on arm64 hosts: vs-agent:local-arm64 (see ../tools/build-vs-agent-image.sh)
VS_AGENT_IMAGE=veranalabs/vs-agent:v2.0.0-dev.91
