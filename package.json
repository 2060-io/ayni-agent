{
  "name": "ayni-agent",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Ayni Agent: a Verifiable Service that holds conversations, keeps memory and performs trust-bound actions (ayni-spec v3)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "pnpm --filter @ayni.org/ayni-agui-profile build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check-format": "biome check --unsafe",
    "fix-format": "biome check --write --unsafe",
    "check-types": "pnpm --filter @ayni.org/ayni-agui-profile build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "pnpm check-types && pnpm check-format",
    "pack:validate": "tsx src/cli/validate-pack.ts"
  },
  "dependencies": {
    "@ayni.org/ayni-agui-profile": "workspace:*",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1150.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "@cosmjs/stargate": "^0.39.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@verana-labs/verana-types": "0.10.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "openai": "^7.32.0",
    "pdfjs-dist": "^4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}
